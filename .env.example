# Copy to `.env` (or set in your host's environment settings) before building.
#
# Recommended: branded enquiry emails via EmailJS (https://www.emailjs.com).
# Set all three; the email design is in emails/enquiry-template.html.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Fallback when EmailJS is not set: the form posts here. Leave unset to email
# submissions via FormSubmit to `company.enquiryInbox` in src/data/content.js.
#   FormSubmit: https://formsubmit.co/ajax/<random-alias-from-activation-email>
#   Formspree:  https://formspree.io/f/<your-form-id>
VITE_CONTACT_ENDPOINT=

# Optional second channel: every enquiry is also saved to the owner's Google Sheet
# (and emailed from their Gmail). Paste the Apps Script web app URL ending in /exec.
# Setup steps are at the top of google-apps-script/Code.gs.
VITE_SHEETS_ENDPOINT=
