# Copy to `.env` (or set in your host's environment settings) before building.
#
# Where the contact form posts. Any endpoint that accepts a JSON POST works, e.g.
#   Formspree:  https://formspree.io/f/<your-form-id>
#   Getform:    https://getform.io/f/<your-form-id>
# Leave unset in development to use the built-in mock (vite.config.js).
VITE_CONTACT_ENDPOINT=
