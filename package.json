{
  "name": "prostaff-solution",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "description": "Prostaff Solution Pvt. Ltd. - premium staffing for the luxury lifestyle sector",
  "scripts": {
    "dev": "vite --host",
    "start": "vite --open --host",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:ghpages": "vite build --mode ghpages && vite build --mode ghpages --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:client": "vite build",
    "build:file": "vite build --mode file",
    "images:hero": "node scripts/hero-images.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test --project=desktop --project=mobile",
    "test:live": "playwright test --config playwright.live.config.js",
    "test:e2e:browsers": "npm run build && playwright test",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"scripts/**/*.mjs\"",
    "deploy:ghpages": "npm run build:ghpages && npx gh-pages -d dist --dotfiles --nojekyll"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "framer-motion": "^11.11.17",
    "lenis": "^1.3.26",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.15",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
